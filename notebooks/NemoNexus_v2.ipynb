   "source": [
    "# Load test data\n",
    "try:\n",
    "    with open('/kaggle/input/arc-prize-2025/arc-agi_test_challenges.json', 'r') as f:\n",
    "        test_challenges = json.load(f)\n",
    "    print(f'Loaded {len(test_challenges)} test tasks')\n",
    "except Exception as e:\n",
    "    print(f'Error loading test data: {e}')\n",
    "    test_challenges = {}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Generate solutions using OLYMPUS\n",
    "solutions = {}\n",
    "processed = 0\n",
    "\n",
    "for task_id, task in test_challenges.items():\n",
    "    try:\n",
    "        predictions = nemo.solve_task(task)\n",
    "        solutions[task_id] = predictions\n",
    "        processed += 1\n",
    "        \n",
    "        if processed % 50 == 0:\n",
    "            print(f'NemoNexus processed {processed}/{len(test_challenges)} tasks')\n",
    "            \n",
    "    except Exception as e:\n",
    "        print(f'Error on task {task_id}: {e}')\n",
    "        solutions[task_id] = [{\"attempt_1\": [[0]], \"attempt_2\": [[0]]}]\n",
    "\n",
    "print(f'NemoNexus generated solutions for {len(solutions)} tasks')"
   ]
  },
  {
   "cell_type": "code",
