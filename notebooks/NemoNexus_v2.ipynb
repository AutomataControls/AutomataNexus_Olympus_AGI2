   "source": [
    "# Initialize NemoNexus with your trained model\n",
    "nemo = NemoNexus(model_dir='/kaggle/input/nemonexus-models')\n",
    "print('NemoNexus OLYMPUS ensemble initialized')"
   ]
  },
  {
