   "source": [
    "# NemoNexus v2 - OLYMPUS Ensemble for ARC Prize 2025"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\n",
    "import torch.nn as nn\n",
    "import numpy as np\n",
    "import json\n",
    "import os\n",
    "from typing import Dict, List, Any, Tuple, Optional\n",
    "\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\n",
    "print(f'Device: {device}')\n",
    "print('NemoNexus v2 - OLYMPUS Ensemble Loading...')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# OLYMPUS Specialist Models from your training\n",
    "class SpecialistModel(nn.Module):\n",
    "    def __init__(self, max_grid_size=30, d_model=256, specialist_type='MINERVA'):\n",
    "        super().__init__()\n",
    "        self.specialist_type = specialist_type\n",
    "        self.max_grid_size = max_grid_size\n",
    "        self.d_model = d_model\n",
    "        \n",
    "        # Input embedding\n",
    "        self.input_embedding = nn.Embedding(10, d_model)\n",
    "        \n",
    "        # Specialist-specific architecture\n",
    "        if specialist_type == 'MINERVA':\n",
    "            # Strategic grid analysis & logical reasoning\n",
    "            self.encoder = nn.TransformerEncoder(\n",
    "                nn.TransformerEncoderLayer(d_model, 8, 1024, dropout=0.0, batch_first=True),\n",
    "                num_layers=6\n",
    "            )\n",
    "        elif specialist_type == 'ATLAS':\n",
    "            # Spatial transformations & pattern mapping\n",
    "            self.encoder = nn.TransformerEncoder(\n",
    "                nn.TransformerEncoderLayer(d_model, 8, 512, dropout=0.0, batch_first=True),\n",
    "                num_layers=4\n",
    "            )\n",
    "        elif specialist_type == 'IRIS':\n",
    "            # Color relationships & visual patterns\n",
    "            self.encoder = nn.TransformerEncoder(\n",
    "                nn.TransformerEncoderLayer(d_model, 4, 512, dropout=0.0, batch_first=True),\n",
    "                num_layers=3\n",
    "            )\n",
    "        elif specialist_type == 'CHRONOS':\n",
    "            # Temporal sequences & multi-step transformations\n",
    "            self.encoder = nn.TransformerEncoder(\n",
    "                nn.TransformerEncoderLayer(d_model, 8, 1024, dropout=0.0, batch_first=True),\n",
    "                num_layers=8\n",
    "            )\n",
    "        else:  # PROMETHEUS\n",
    "            # Creative pattern generation & synthesis\n",
    "            self.encoder = nn.TransformerEncoder(\n",
    "                nn.TransformerEncoderLayer(d_model, 6, 768, dropout=0.0, batch_first=True),\n",
    "                num_layers=6\n",
    "            )\n",
    "        \n",
    "        # Output head\n",
    "        self.output_head = nn.Linear(d_model, 10)\n",
    "        \n",
    "    def forward(self, input_grid, target_shape=None):\n",
    "        B, H, W = input_grid.shape\n",
    "        \n",
    "        # Embed input\n",
    "        x = self.input_embedding(input_grid.long())  # B, H, W, d_model\n",
    "        x = x.view(B, H*W, self.d_model)  # B, H*W, d_model\n",
    "        \n",
    "        # Encode\n",
    "        x = self.encoder(x)\n",
    "        \n",
    "        # Output prediction\n",
    "        x = self.output_head(x)  # B, H*W, 10\n",
    "        \n",
    "        if target_shape:\n",
    "            target_h, target_w = target_shape\n",
    "            # Reshape to target dimensions if needed\n",
    "            if target_h * target_w == H * W:\n",
    "                x = x.view(B, target_h, target_w, 10)\n",
    "            else:\n",
    "                x = x.view(B, H, W, 10)\n",
    "        else:\n",
    "            x = x.view(B, H, W, 10)\n",
    "        \n",
    "        return x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Task Router from your system\n",
    "class TaskRouter(nn.Module):\n",
    "    def __init__(self, d_model=256):\n",
    "        super().__init__()\n",
    "        self.classifier = nn.Sequential(\n",
    "            nn.Linear(d_model, 128),\n",
    "            nn.ReLU(),\n",
    "            nn.Linear(128, 5),  # 5 specialists\n",
    "            nn.Softmax(dim=-1)\n",
    "        )\n",
    "        \n",
    "    def forward(self, grid_features):\n",
    "        # Simple pooling for routing decision\n",
    "        pooled = torch.mean(grid_features, dim=1)  # B, d_model\n",
    "        weights = self.classifier(pooled)  # B, 5\n",
    "        return weights"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# OLYMPUS Ensemble - Your main system\n",
    "class OLYMPUSEnsemble(nn.Module):\n",
    "    def __init__(self, max_grid_size=30, d_model=256):\n",
    "        super().__init__()\n",
    "        self.max_grid_size = max_grid_size\n",
    "        self.d_model = d_model\n",
    "        \n",
    "        # 5 Specialist models from your training\n",
    "        self.specialists = nn.ModuleDict({\n",
    "            'MINERVA': SpecialistModel(max_grid_size, d_model, 'MINERVA'),\n",
    "            'ATLAS': SpecialistModel(max_grid_size, d_model, 'ATLAS'),\n",
    "            'IRIS': SpecialistModel(max_grid_size, d_model, 'IRIS'),\n",
    "            'CHRONOS': SpecialistModel(max_grid_size, d_model, 'CHRONOS'),\n",
    "            'PROMETHEUS': SpecialistModel(max_grid_size, d_model, 'PROMETHEUS')\n",
    "        })\n",
    "        \n",
    "        # Task router for intelligent weighting\n",
    "        self.task_router = TaskRouter(d_model)\n",
    "        \n",
    "    def forward(self, input_grid, train_examples=None, target_shape=None):\n",
    "        B, H, W = input_grid.shape\n",
    "        \n",
    "        # Get specialist predictions\n",
    "        specialist_outputs = {}\n",
    "        \n",
    "        # Embed input for routing\n",
    "        input_embedded = self.specialists['MINERVA'].input_embedding(input_grid.long())\n",
    "        input_embedded = input_embedded.view(B, H*W, self.d_model)\n",
    "        \n",
    "        # Get routing weights\n",
    "        routing_weights = self.task_router(input_embedded)  # B, 5\n",
    "        \n",
    "        # Get predictions from each specialist\n",
    "        for i, (name, specialist) in enumerate(self.specialists.items()):\n",
    "            specialist_pred = specialist(input_grid, target_shape)\n",
    "            specialist_outputs[name] = specialist_pred\n",
    "        \n",
    "        # Weighted ensemble\n",
    "        ensemble_output = None\n",
    "        specialist_names = list(self.specialists.keys())\n",
    "        \n",
    "        for i, name in enumerate(specialist_names):\n",
    "            weight = routing_weights[:, i:i+1, None, None]  # B, 1, 1, 1\n",
    "            weighted_pred = specialist_outputs[name] * weight\n",
    "            \n",
    "            if ensemble_output is None:\n",
    "                ensemble_output = weighted_pred\n",
    "            else:\n",
    "                ensemble_output += weighted_pred\n",
    "        \n",
    "        return ensemble_output\n",
    "    \n",
    "    def load_trained_weights(self, model_dir='/kaggle/input/nemonexus-models'):\n",
    "        \"\"\"Load your trained NemoNexus weights\"\"\"\n",
    "        try:\n",
    "            # Load your NemoNexus model\n",
    "            model_path = os.path.join(model_dir, 'NemoNexus.pt')\n",
    "            if os.path.exists(model_path):\n",
    "                checkpoint = torch.load(model_path, map_location=device)\n",
    "                self.load_state_dict(checkpoint, strict=False)\n",
    "                print(f'Loaded NemoNexus trained weights from {model_path}')\n",
    "                return True\n",
    "        except Exception as e:\n",
    "            print(f'Could not load NemoNexus weights: {e}')\n",
    "        \n",
    "        print('Using randomly initialized weights')\n",
    "        return False"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# NemoNexus - Your complete system\n",
    "class NemoNexus:\n",
    "    def __init__(self, model_dir=None):\n",
    "        self.olympus = OLYMPUSEnsemble().to(device)\n",
    "        \n",
    "        # Load your trained NemoNexus weights\n",
    "        if model_dir:\n",
    "            self.olympus.load_trained_weights(model_dir)\n",
    "        \n",
    "        self.olympus.eval()\n",
    "    \n",
    "    def solve_task(self, task):\n",
    "        \"\"\"Solve ARC task using your OLYMPUS ensemble\"\"\"\n",
    "        try:\n",
    "            # Extract training examples\n",
    "            train_examples = task.get('train', [])\n",
    "            test_cases = task.get('test', [])\n",
    "            \n",
    "            predictions = []\n",
    "            \n",
    "            for test_case in test_cases:\n",
    "                input_grid = np.array(test_case['input'])\n",
    "                \n",
    "                # Convert to tensor\n",
    "                input_tensor = torch.tensor(input_grid, dtype=torch.long).unsqueeze(0).to(device)\n",
    "                \n",
    "                with torch.no_grad():\n",
    "                    # Get OLYMPUS prediction\n",
    "                    output_logits = self.olympus(input_tensor, train_examples)\n",
    "                    output_pred = torch.argmax(output_logits, dim=-1)\n",
    "                    pred_grid = output_pred[0].cpu().numpy()\n",
    "                \n",
    "                predictions.append({\n",
    "                    \"attempt_1\": pred_grid.tolist(),\n",
    "                    \"attempt_2\": pred_grid.tolist()\n",
    "                })\n",
    "            \n",
    "            return predictions\n",
    "            \n",
    "        except Exception as e:\n",
    "            print(f'Error solving task: {e}')\n",
    "            # Fallback\n",
    "            return [{\"attempt_1\": [[0]], \"attempt_2\": [[0]]}] * len(task.get('test', [{}]))\n",
    "\n",
    "print('NemoNexus OLYMPUS system ready!')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
